{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "importHelpers": true,
    "strict": true,
    "noImplicitThis": false,
    "moduleResolution": "bundler",
    "types": [],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./examples/**/*.ts",
    "./examples/**/*.tsx",
    "./site/**/*.ts",
    "./site/**/*.tsx"
  ],
  "typedocOptions": {
    "entryPoints": ["./src/index.ts"],
    "out": "docs/api"
  }
}
